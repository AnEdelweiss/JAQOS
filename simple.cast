[0.011, "o", "\u001b[36m╭─\u001b[0m\u001b[36m──────────────────────────────────\u001b[0m\u001b[36m \u001b[0m\u001b[1;36mMain Menu\u001b[0m\u001b[36m \u001b[0m\u001b[36m──────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀\u001b[0m                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⠀⠀⠀⢀⣠⡴⠖⠛⣛⠛⠛⠛⠲⢦⣄⡀⠀⠀⠀\u001b[0m                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⠀⢀⣴⠟⠁⠀⠀⣴⠟⣿⠶⣤⡀⠀⠈⠻⣦⡀⠀\u001b[0m                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⢀⡾⠁⠀⠀⢀⡼⠃⠀⠘⣧⠈⠙⠳⢦⡀⠈⢷⡀\u001b[0m                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⣾⠁⠀⠀⢠⡞⠁⠀⠀⠀⠘⣧⠀⣴⠿⡇⠀⠈⣷\u001b[0m                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⣿⠀⠀⣰⣟⣀⣠⣤⣤⡤⠤⠾⣿⣥⣄⣿⠀⠀⣿   \u001b[0m\u001b[1;36mYour are logged in as\u001b[0m\u001b[1;37m \u001b[0m\u001b[1;32mguest@opensilex.org\u001b[0m\u001b[1;37m \u001b[0m\u001b[1;36mon\u001b[0m\u001b[1;37m \u001b[0m\u001b[1;32mSandbox\u001b[0m\u001b[1;37m.\u001b[0m \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⢿⡀⠀⠹⣟⠳⠶⣤⣄⣀⠀⠀⣿⠀⣨⡟⠀⢀⡿   \u001b[0m                                                      \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⠘⢧⡀⠀⠹⣆⠀⠀⠀⢉⣹⣷⣿⣰⠏⠀⢀⡼⠃\u001b[0m                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⠀⠈⠳⣄⡀⠘⣧⣴⣞⣋⣁⣀⣿⠋⢀⣠⠞⠁⠀\u001b[0m                                                         \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⠀⠀⠀⠈⠙⠶⢦⣤⣄⣀⣠⣤⡴⠶⠛⠁⠀\u001b[0m                                                           \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[32m    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀\u001b[0m                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m     \u001b[31m[1]\u001b[0m Log in.                                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m     \u001b[32m[2]\u001b[0m Look up experiment info.                                                \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m     \u001b[36m[3]\u001b[0m I want to create experiment/factors/scientific object...                \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m     \u001b[33m[4]\u001b[0m Help.                                                                   \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m     \u001b[36m[9]\u001b[0m Quit the client.                                                        \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m                                                                                 \u001b[36m│\u001b[0m\r\n\u001b[36m╰─────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
