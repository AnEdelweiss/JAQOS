[0.006, "o", "\r\n\u001b[32m⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀\u001b[0m\r\n\u001b[32m⠀⠀⠀⠀⠀⠀⠀⠀⣀⣤⣶⣶⠿⠿⠿⠿⠿⠿⠿⣶⣶⣤⣀⠀⠀⠀⠀⠀⠀⠀⠀\u001b[0m\r\n\u001b[32m⠀⠀⠀⠀⠀⣠⣴⡿⠟⠋⠁⠀⠀⣴⣶⣄⡀⠀⠀⠀⠈⠉⠛⢿⣦⣄⠀⠀⠀⠀⠀\u001b[0m\r\n\u001b[32m⠀⠀⠀⣠⣾⠟⠉⠀⠀⠀⠀⢀⣾⡟⢻⣿⠿⣷⣤⣀⠀⠀⠀⠀⠈⠻⣷⣄⠀⠀⠀\u001b[0m\r\n\u001b[32m⠀⠀⣴⡿⠁⠀⠀⠀⠀⠀⢠⣾⠏⠀⠀⢻⣧⡀⠙⠻⢷⣦⣄⠀⠀⠀⠈⢿⣦⠀⠀\u001b[0m\r\n\u001b[32m⠀⣼⡟⠀⠀⠀⠀⠀⠀⣰⣿⠃⠀⠀⠀⠀⢻⣷⡀⠀⠀⠉⠛⢿⣶⠀⠀⠀⢻⣧⠀\u001b[0m\r\n\u001b[32m⣸⡿⠀⠀⠀⠀⠀⠀⣴⡿⠁⠀⠀⠀⠀⠀⠀⢻⣷⡀⠀⠀⣴⣿⣿⡆⠀⠀⠀⢿⡇\u001b[0m\r\n\u001b[32m⣿⡇⠀⠀⠀⠀⢀⣾⡟⠀⠀⠀⠀⠀⠀⠀⠀⠀⢻⣷⣠⣾⠟⠁⢿⣇⠀⠀⠀⢸⣿\u001b[0m\r\n\u001b[32m⣿⡁⠀⠀⠀⢠⣿⢏⣀⣀⣀⣠⣤⣤⣤⣤⣶⣶⣶⣿⣿⣧⣤⣀⣸⣿⠀⠀⠀⢸⣿    \u001b[0m\u001b[36m⊹₊˚‧︵‿₊୨ \u001b[0m\u001b[1;32mWelcome on SIMPLE \u001b[0m\u001b[1;36m୧₊‿︵‧˚₊⊹\u001b[0m\r\n\u001b[1;32m⣿⡇⠀⠀⠀⢿⣿⣿⣿⣟⣛⠋⠉⠉⠉⠉⠀⠀⠀⢸⣿⠈⠉⠛⢻⣿⠀⠀⠀⢸⣿\u001b[0m\r\n\u001b[1;32m⢹⣷⠀⠀⠀⠈⢿⣯⠉⠙⠛⠿⢷⣶⣤⣄⣀⠀⠀⢸⣿⠀⠀⣰⡿⠃⠀⠀⠀⣾⡏\u001b[0m\r\n\u001b[1;32m⠀⢿⣧⠀⠀⠀⠈⢿⣧⠀⠀⠀⠀⠀⠉⠙⠛⠿⣷⣾⣿⠀⣴⡿⠁⠀⠀⠀⣼⡿⠀\u001b[0m\r\n\u001b[1;32m⠀⠈⢻⣧⡀⠀⠀⠀⢻⣧⠀⠀⠀⢀⣠⣤⣶⡿⠟⢻⣿⣼⡟⠁⠀⠀⢀⣼⡟⠁⠀\u001b[0m\r\n\u001b[1;32m⠀⠀⠀⠙⢿⣦⡀⠀⠀⢻⣷⣴⣾⣿⣛⣉⣀⣀⣀⣸⣿⡟⠀⠀⢀⣴⣿⠏⠀⠀⠀\u001b[0m\r\n\u001b[1;32m⠀⠀⠀⠀⠀⠙⢿⣶⣤⣀⠛⠛⠛⠛⠛⠛⠛⠛⠛⠛⠛⣀⣤⣶⡿⠋⠀⠀⠀⠀⠀\u001b[0m\r\n\u001b[1;32m⠀⠀⠀⠀⠀⠀⠀⠈⠙⠻⠿⣷⣶⣦⣤⣤⣤⣴⣶⣾⠿⠟⠋⠁⠀⠀⠀⠀⠀⠀⠀       \u001b[0m\r\n\r\n\u001b[1;32m  \u001b[0m\u001b[1;32m[\u001b[0m\u001b[1;32m+\u001b[0m\u001b[1;32m]\u001b[0m\u001b[1;32m Simple Interface MIAPPE-Phis Lightweight & Efficient\u001b[0m\r\n\u001b[1;32m  \u001b[0m\u001b[1;36m[\u001b[0m\u001b[1;36m+\u001b[0m\u001b[1;36m]\u001b[0m\u001b[1;36m You can chose an option by typing the associated number and pressing \u001b[0m\u001b[1;36m'enter'\u001b[0m\r\n\u001b[1;36m  \u001b[0m\u001b[1;33m[\u001b[0m\u001b[1;33m+\u001b[0m\u001b[1;33m]\u001b[0m\u001b[1;33m You will be logged as a guest by default, you can log in to change user.\u001b[0m\r\n\u001b[1;36m  \u001b[0m\u001b[1;32m[\u001b[0m\u001b[1;32m+\u001b[0m\u001b[1;32m]\u001b[0m\u001b[1;32m Please read the README.md file available on the github for guidance.\u001b[0m\r\n\u001b[1;32m  \u001b[0m\r\n\u001b[1;32m  \u001b[0m\u001b[1;37mVERSION-SIMPLE\u001b[0m\u001b[1;32m    = \u001b[0m\u001b[1;32m0.23\u001b[0m\u001b[1;32m.\u001b[0m\u001b[1;32m0\u001b[0m\u001b[1;32m Try out the gui ! \u001b[0m\r\n\u001b[1;32m  \u001b[0m\u001b[1;37mVERSION-OpenSilex\u001b[0m\u001b[1;32m = \u001b[0m\u001b[1;32m1.5\u001b[0m\u001b[1;32m.\u001b[0m\u001b[1;32m2\u001b[0m\r\n\u001b[1;32m  \u001b[0m\u001b[1;37mVERSION-MIAPPE\u001b[0m\u001b[1;32m    = \u001b[0m\u001b[1;32m1.2\u001b[0m\r\n\u001b[1;32m  \u001b[0m\u001b[1;37mMade By\u001b[0m\u001b[1;32m           = \u001b[0m\u001b[1;32m•┈••✦ Edelweiss ✦••┈•\u001b[0m\r\n\r\n"]
